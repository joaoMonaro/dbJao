<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../GameBackend.Api/GameBackend.Api.csproj" />
    <Compile Include="../../scripts/Progression/*.cs" Link="Progression/%(Filename)%(Extension)" />
    <Compile Include="../../scripts/Characters/*.cs" Link="Characters/%(Filename)%(Extension)" />
    <Compile Include="../../scripts/Combat/PhysicalDamageCalculator.cs" Link="Combat/PhysicalDamageCalculator.cs" />
    <Compile Include="../../scripts/Stages/StageIds.cs" Link="Stages/StageIds.cs" />
    <Compile Include="../../scripts/Stages/StageRoute.cs" Link="Stages/StageRoute.cs" />
    <Compile Include="../../scripts/Stages/StageSpawnRules.cs" Link="Stages/StageSpawnRules.cs" />
    <Compile Include="../../scripts/Enemies/EnemyDefinition.cs" Link="Enemies/EnemyDefinition.cs" />
    <Compile Include="../../scripts/Enemies/EnemyRegistry.cs" Link="Enemies/EnemyRegistry.cs" />
  </ItemGroup>
</Project>
